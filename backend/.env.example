# All settings are optional — these are the defaults.
CSM_DEBUG=false
CSM_MAX_ACTIVE_PRESENTATIONS=8
CSM_MAX_UPLOAD_MB=25
CSM_DEFAULT_LANGUAGE=en

# Translation engine: null | anthropic | ollama.
#
#   null       returns the source text — no translation, never a wrong one
#   anthropic  Claude, over the network; the key never leaves the backend
#   ollama     a model on this machine; the text never leaves it either
#
CSM_TRANSLATION_PROVIDER=null

# --- anthropic ---
CSM_TRANSLATION_MODEL=claude-sonnet-5
# CSM_ANTHROPIC_API_KEY=sk-ant-...

# --- ollama (requires `ollama serve`) ---
CSM_OLLAMA_URL=http://127.0.0.1:11434
CSM_OLLAMA_MODEL=gemma4:e2b
